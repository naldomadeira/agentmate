  "description": "Let Claude Code and Codex CLI ask, review, research, plan, implement and lead each other as background jobs.",
  "author": {
    "name": "Naldo Madeira",
    "url": "https://github.com/naldomadeira"
  },
  "repository": "https://github.com/naldomadeira/agents-bridge-mcp",
