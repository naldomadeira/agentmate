  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "codex",
    "codex-cli",
    "delegation",
    "multi-agent",
    "jobs"
  ],
  "skills": "./skills/",
  "agents": [
    "./agents/codex-teammate.md",
    "./agents/codex-reviewer.md",
